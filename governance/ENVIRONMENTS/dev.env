# 生产环境配置
# 当前生产运行配置按 dev/test 方式由 application-prod.yaml 直接提供；本文件仅用于部署脚本和基础设施元数据。

ENV_NAME=dev
SPRING_PROFILES_ACTIVE=dev2
SERVER_HOST=139.224.55.46
DEPLOY_USER=root
SSH_KEY_PATH=$HOME/.ssh/yshop-sh-dev-key.pem


YSHOP_PORT=8888
YSHOP_SERVER_LOG_FILE=/mnt/yshop-nas/applogs/yshop-server/server.log
YSHOP_ACCESS_LOG_FILE=/mnt/yshop-nas/applogs/yshop-server/access.log

# yshop-drink-vue 管理后台
ADMIN_LOCAL_PATH=admin
ADMIN_BUILD_CMD="pnpm build:prod"
ADMIN_REMOTE_PATH=/opt/holun/yshop-drink-vue/dist

# icepolar H5 活动前端
H5_LOCAL_PATH=h5
H5_SERVER_HOST=
H5_DEPLOY_USER=
H5_REMOTE_PATH=/opt/holun/yshop-h5/dist
H5_API_BASE_URL=https://yshop-api.holuntech.cn/app-api
H5_TENANT_ID=154
H5_TEST_AUTH_ENABLED=false

# 测试环境数据库（阿里云 RDS MySQL）
DB_HOST=mysql-dev.holuntech.cn
DB_PORT=3306
DB_NAME=yshop
DB_USER=root
DB_PASSWORD=admin123456
DB_CHARSET=utf8mb4

# 域名配置（用于 Nginx server_name、管理后台 URL、API 调用等）
DOMAIN_ADMIN=yshop-admi-dev.holuntech.cn
DOMAIN_API=yshop-api-dev.holuntech.cn
DOMAIN_H5=yshop-h5-dev.holuntech.cn
YSHOP_ADMIN_UI_URL=https://yshop-admin-dev.holuntech.cn
YSHOP_H5_URL=https://yshop-h5-dev.holuntech.cn

# 测试环境 Redis（阿里云 Redis）
REDIS_HOST=redis-dev.holuntech.cn
REDIS_PORT=6379
REDIS_DATABASE=0
