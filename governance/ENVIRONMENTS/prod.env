# 生产环境配置
# 本文件只包含部署元数据；业务应用的真实数据库密码从 application-*.yaml 或阿里云 KMS/环境变量注入。
# 当前将密码暂存于此，后续应迁移至密钥管理服务。

ENV_NAME=prod
SERVER_HOST=47.116.198.253
DEPLOY_USER=root

# yshop 后端
YSHOP_CODE_PATH=/opt/holun/yshop-drink
YSHOP_START_PATH=/opt/holun/yshop-drink/yshop-server
YSHOP_JAR=yshop-server.jar
YSHOP_GIT_REMOTE=gitee
YSHOP_GIT_BRANCH=master
