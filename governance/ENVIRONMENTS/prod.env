# 生产环境配置
# 本文件只包含部署元数据。除 application-prod.yaml 中按当前 dev/test 方式保留的
# DB/Redis 密码和 OCR 配置外，生产运行时凭据必须放在服务器上的
# ${YSHOP_SECRET_ENV_FILE}，禁止写入仓库或通过命令行传递。

ENV_NAME=prod
SPRING_PROFILES_ACTIVE=prod
SERVER_HOST=47.116.198.253
DEPLOY_USER=root
YSHOP_SECRET_ENV_FILE=/etc/holun/yshop-prod.env

# yshop 后端
YSHOP_CODE_PATH=/opt/holun/yshop-drink
YSHOP_START_PATH=/opt/holun/yshop-drink/yshop-server
YSHOP_JAR=yshop-server.jar
YSHOP_PORT=8080

# yshop-drink-vue 管理后台
ADMIN_LOCAL_PATH=admin
ADMIN_BUILD_CMD="pnpm build:prod"
ADMIN_REMOTE_PATH=/opt/holun/yshop-drink-vue/dist

# 生产环境数据库（阿里云 RDS MySQL）
DB_HOST=rm-uf617t0dkj52h32v2.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=yshop
DB_USER=newmall
DB_CHARSET=utf8mb4

# icepolar-dms 设备管理系统
DMS_CODE_PATH=/opt/holun/icepolar/icepolar-dms
DMS_PORT=8001
DMS_DB_HOST=${DB_HOST}
DMS_DB_PORT=${DB_PORT}
DMS_DB_NAME=dms
DMS_DB_USER=newmall



# 域名配置（用于 Nginx server_name、管理后台 URL、API 调用等）
DOMAIN_ADMIN=yshop-admin.holuntech.cn
DOMAIN_API=yshop-api.holuntech.cn
DOMAIN_DMS=dms.holuntech.cn
DMS_HOST=https://dms.holuntech.cn
YSHOP_ADMIN_UI_URL=https://yshop-admin.holuntech.cn
YSHOP_H5_URL=https://yshop-api.holuntech.cn

# 生产环境 Redis（阿里云 Redis）
REDIS_HOST=r-uf6a7v65bq6mlzv1tj.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_DATABASE=0
