# 测试环境配置
# 本文件只包含非敏感元数据；密码、密钥等敏感信息请存放在 application-*.yaml 或密钥管理服务中。

ENV_NAME=test
SERVER_HOST=139.196.173.216
DEPLOY_USER=root

# yshop 后端
YSHOP_CODE_PATH=/opt/holun/yshop-drink
YSHOP_START_PATH=/opt/holun/yshop-drink/yshop-server
YSHOP_JAR=yshop-server.jar
YSHOP_PORT=8888

# yshop-drink-vue 管理后台
ADMIN_LOCAL_PATH=admin
ADMIN_BUILD_CMD="pnpm build:dev"
ADMIN_REMOTE_PATH=/opt/holun/yshop-drink-vue/dist

# 测试环境数据库连接信息（密码见 application-dev.yaml）
DB_HOST=47.101.64.142
DB_PORT=13306
DB_NAME=yshop_pro
DB_USER=root

# 测试环境 Redis
REDIS_HOST=r-uf62407d9ubwrgpos1pd.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_DATABASE=7

# icepolar-dms 设备管理系统
DMS_CODE_PATH=/opt/holun/icepolar/icepolar-dms
DMS_PORT=8001
DMS_DB_HOST=${DB_HOST}
DMS_DB_PORT=${DB_PORT}
DMS_DB_NAME=dms
DMS_DB_USER=root
DMS_DB_PASSWORD=admin123456

# 域名配置（用于 Nginx server_name、管理后台 URL、API 调用等）
DOMAIN_ADMIN=yshop-admin.holuntech.com
DOMAIN_API=yshop-api.holuntech.com
DOMAIN_DMS=dms.holuntech.com

# API 测试租户（非敏感元数据）
TEST_TENANT_ID=153
