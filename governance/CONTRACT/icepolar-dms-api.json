        "/api/v1/devices/{device_imei}/status": {
            "get": {
                "tags": [
                    "\u8bbe\u5907\u7ba1\u7406"
                ],
                "summary": "Get Device Status",
                "description": "\u83b7\u53d6\u8bbe\u5907\u72b6\u6001\n\n\u67e5\u8be2\u6307\u5b9a\u8bbe\u5907\u7684\u5f53\u524d\u72b6\u6001\u4fe1\u606f\uff0c\u5305\u62ec\u8fde\u63a5\u72b6\u6001\u3001\u5728\u7ebf\u72b6\u6001\u548c\u6700\u540e\u5fc3\u8df3\u65f6\u95f4\u3002\n\n\u4efb\u52a122/24\uff1a\u8bbe\u5907\u72b6\u6001\u67e5\u8be2\u63a5\u53e3\u5b9e\u73b0\n- \u8c03\u7528\u8bbe\u5907\u7ba1\u7406\u5668\u83b7\u53d6\u8bbe\u5907\u72b6\u6001\n- \u5904\u7406\u8bbe\u5907\u4e0d\u5b58\u5728\u7684\u60c5\u51b5\n- \u8fd4\u56de\u6807\u51c6\u54cd\u5e94\u683c\u5f0f\n\nArgs:\n    device_imei: \u8bbe\u5907IMEI\u53f7\n\nReturns:\n    \u8bbe\u5907\u72b6\u6001\u54cd\u5e94",
                "operationId": "get_device_status_api_v1_devices__device_imei__status_get",
                "parameters": [
                    {
                        "name": "device_imei",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "minLength": 15,
                            "maxLength": 50,
                            "description": "\u8bbe\u5907IMEI\u53f7",
                            "title": "Device Imei"
                        },
                        "description": "\u8bbe\u5907IMEI\u53f7"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DeviceStatusResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
