        "/api/v1/commands/{device_imei}/{command}": {
            "post": {
                "tags": [
                    "\u8bbe\u5907\u6307\u4ee4"
                ],
                "summary": "Send Device Command",
                "description": "\u4e0b\u53d1\u8bbe\u5907\u6307\u4ee4\n\n\u8be5\u63a5\u53e3\u7528\u4e8e\u76f4\u63a5\u5411\u8bbe\u5907\u4e0b\u53d1\u63a7\u5236\u6307\u4ee4\uff0c\u4e0d\u521b\u5efa\u8ba2\u5355\u3002\n\u6307\u4ee4\u5b9a\u4e49\uff1a\n1=\u6c34\u6876\u95e8\uff0c2=\u676f\u5b50\u95e8\uff0c3=\u5f00\u59cb\u5236\u51b0\uff0c4=\u505c\u6b62\u5236\u51b0\uff0c5=\u84b8\u53d1\u5668\u5316\u51b0\uff0c6=\u51b0\u6876\u5316\u51b0\uff0c7=\u51fa\u51b0\uff0c8=\u51fa\u676f\uff0c9=\u81ea\u6e05\u6d17\uff0c10=\u8bed\u97f3\uff0c11=\u6388\u65f6\uff0c12-16=\u9884\u7559\u3002",
                "operationId": "send_device_command_api_v1_commands__device_imei___command__post",
                "parameters": [
                    {
                        "name": "device_imei",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "minLength": 15,
                            "maxLength": 50,
                            "description": "\u8bbe\u5907IMEI\u53f7",
                            "title": "Device Imei"
                        },
                        "description": "\u8bbe\u5907IMEI\u53f7"
                    },
                    {
                        "name": "command",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "maximum": 16,
                            "minimum": 1,
                            "description": "\u8bbe\u5907\u63a7\u5236\u6307\u4ee4\uff1a1=\u6c34\u6876\u95e8\uff0c2=\u676f\u5b50\u95e8\uff0c3=\u5f00\u59cb\u5236\u51b0\uff0c4=\u505c\u6b62\u5236\u51b0\uff0c5=\u84b8\u53d1\u5668\u5316\u51b0\uff0c6=\u51b0\u6876\u5316\u51b0\uff0c7=\u51fa\u51b0\uff0c8=\u51fa\u676f\uff0c9=\u81ea\u6e05\u6d17\uff0c10=\u8bed\u97f3\uff0c11=\u6388\u65f6\uff0c12-16=\u9884\u7559",
                            "title": "Command"
                        },
                        "description": "\u8bbe\u5907\u63a7\u5236\u6307\u4ee4\uff1a1=\u6c34\u6876\u95e8\uff0c2=\u676f\u5b50\u95e8\uff0c3=\u5f00\u59cb\u5236\u51b0\uff0c4=\u505c\u6b62\u5236\u51b0\uff0c5=\u84b8\u53d1\u5668\u5316\u51b0\uff0c6=\u51b0\u6876\u5316\u51b0\uff0c7=\u51fa\u51b0\uff0c8=\u51fa\u676f\uff0c9=\u81ea\u6e05\u6d17\uff0c10=\u8bed\u97f3\uff0c11=\u6388\u65f6\uff0c12-16=\u9884\u7559"
                    }
