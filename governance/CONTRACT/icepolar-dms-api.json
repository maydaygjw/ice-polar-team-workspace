        "/api/v1/orders/initiate": {
            "post": {
                "tags": [
                    "\u8ba2\u5355\u7ba1\u7406"
                ],
                "summary": "Initiate Ice Order",
                "description": "\u89e6\u53d1\u51fa\u51b0\u8ba2\u5355\uff08\u96c6\u6210MQTT\u901a\u4fe1\uff09\n\n\u5411\u6307\u5b9a\u8bbe\u5907\u53d1\u8d77\u51fa\u51b0\u8bf7\u6c42\uff0c\u901a\u8fc7MQTT\u534f\u8bae\u4e0e\u8bbe\u5907\u901a\u4fe1\uff0c\u521b\u5efa\u8ba2\u5355\u5e76\u5f00\u59cb\u51fa\u51b0\u6d41\u7a0b\u3002\n\n\u4efb\u52a130\uff1a\u89e6\u53d1\u51fa\u51b0\u63a5\u53e3\u5b9e\u73b0\n\u4efb\u52a138\uff1a\u66f4\u65b0\u89e6\u53d1\u51fa\u51b0\u63a5\u53e3\u4f7f\u7528\u771f\u5b9e\u4e1a\u52a1\u5c42\n\u4efb\u52a155\uff1a\u6700\u7ec8\u66f4\u65b0\u89e6\u53d1\u51fa\u51b0\u63a5\u53e3\n- \u8c03\u7528\u96c6\u6210\u4e86MQTT\u7684\u8ba2\u5355\u7ba1\u7406\u5668\n- \u901a\u8fc7MQTT\u534f\u8bae\u4e0e\u8bbe\u5907\u8fdb\u884c\u771f\u5b9e\u901a\u4fe1\n- \u4f7f\u7528correlation_id\u8ddf\u8e2a\u8bf7\u6c42-\u54cd\u5e94\n- \u7b49\u5f85\u8bbe\u5907MQTT\u54cd\u5e94\u540e\u624d\u521b\u5efa\u8ba2\u5355\n- \u5b9e\u73b0\u53c2\u6570\u6821\u9a8c\u548c\u6807\u51c6\u54cd\u5e94\u683c\u5f0f\n- \u5904\u7406\u8bbe\u5907\u4e0d\u53ef\u7528\u3001\u8ba2\u5355\u91cd\u590d\u3001MQTT\u8d85\u65f6\u7b49\u5f02\u5e38\u60c5\u51b5\n- \u96c6\u6210\u6570\u636e\u5e93\u64cd\u4f5c\u548c\u8bbe\u5907\u72b6\u6001\u68c0\u67e5\n\nArgs:\n    request: \u89e6\u53d1\u51fa\u51b0\u8ba2\u5355\u8bf7\u6c42\u53c2\u6570\n\nReturns:\n    \u8ba2\u5355\u89e6\u53d1\u7ed3\u679c\u54cd\u5e94",
                "operationId": "initiate_ice_order_api_v1_orders_initiate_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OrderInitiateRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderInitiateResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
