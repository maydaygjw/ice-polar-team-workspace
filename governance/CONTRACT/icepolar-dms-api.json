                ],
                "summary": "Get Devices Status Batch",
                "description": "\u6279\u91cf\u83b7\u53d6\u8bbe\u5907\u72b6\u6001\n\n\u6279\u91cf\u67e5\u8be2\u591a\u4e2a\u8bbe\u5907\u7684\u5f53\u524d\u72b6\u6001\u4fe1\u606f\uff0c\u5305\u62ec\u8fde\u63a5\u72b6\u6001\u3001\u5728\u7ebf\u72b6\u6001\u548c\u6700\u540e\u5fc3\u8df3\u65f6\u95f4\u3002\n\n\u4efb\u52a126/28\uff1a\u6279\u91cf\u8bbe\u5907\u72b6\u6001\u67e5\u8be2\u63a5\u53e3\u5b9e\u73b0\n- \u8c03\u7528\u8bbe\u5907\u7ba1\u7406\u5668\u6279\u91cf\u83b7\u53d6\u8bbe\u5907\u72b6\u6001\n- \u5b9e\u73b0\u6279\u91cf\u67e5\u8be2\u4f18\u5316\n- \u8fd4\u56de\u6807\u51c6\u54cd\u5e94\u683c\u5f0f\n\nArgs:\n    request: \u6279\u91cf\u67e5\u8be2\u8bf7\u6c42\uff0c\u5305\u542b\u8bbe\u5907IMEI\u5217\u8868\n\nReturns:\n    \u6279\u91cf\u8bbe\u5907\u72b6\u6001\u54cd\u5e94",
                "operationId": "get_devices_status_batch_api_v1_devices_status_batch_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DeviceStatusBatchRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
